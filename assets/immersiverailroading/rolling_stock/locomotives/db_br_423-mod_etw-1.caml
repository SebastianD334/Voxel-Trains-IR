	animatrix = "immersiverailroading:models/rolling_stock/locomotives/db_br_423-mod/coupled_front.anim"
	mode = "play_both"

animations:
	control_group = "cd1"
	animatrix = "immersiverailroading:models/rolling_stock/locomotives/db_br_423-mod/cab_door.anim"
