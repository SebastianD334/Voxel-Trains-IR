era = diesel
name = "S-Bahn Muenchen BR 424 MTW 2  Modernisiert"
works = "Adtranz / Bombardier, Siemens"
modeler = "CEO_of_Dummheit"
pack = "Voxel Trains"
model = "immersiverailroading:models/rolling_stock/locomotives/db_br_424-mod/db_br_424_mtw-2.obj"
sound_dampening_percentage = 0.6
properties =
	fuel_efficiency_% = 99
	fuel_capacity_l = 1250
	power_kw = 587.5
	tractive_effort_kn = 145
	max_speed_kmh = 140
	weight_kg = 29000
	interior_light_level = 0.75
	linear_brake_control = true
	throttle_notches = 25
	rolling_resistance_coefficient = 0.0007
	drag_coefficient = 0.9
	dynamic_traction_control = true
passenger =
	slots = 56
	center_x = 0
	center_y = 1.4
	length = 7.65
	width = 2.2
trucks =
	front = 8.125
	rear = -6.3125
couplers =
	front_offset = -0.125
	rear_offset = -0.125
	front_slack = 0
	rear_slack = 0
sounds =
	horn = sounds/stille.ogg
	bell = sounds/stille.ogg
	idle = sounds/stille.ogg
	running = sounds/db/br_425_accelerate.ogg
overlay = "immersiverailroading:vtgui/ui/power.caml"
lights =
	HEADLIGHT_1 =
		texture = immersiverailroading:textures/no_flare.png
	HEADLIGHT_2 =
		texture = immersiverailroading:textures/no_flare.png
	
animations:
	readout = "engine"
	animatrix = "immersiverailroading:models/rolling_stock/locomotives/db_br_425/zza_off.anim"
	mode = "play_both"
	invert = true

animations:
	readout = "engine"
	animatrix = "immersiverailroading:models/rolling_stock/locomotives/db_br_425/idle.anim"
	mode = "loop"
	sound = "sounds/db/br_423_ac.ogg"

animations:
	control_group = "dfl"
	animatrix = "immersiverailroading:models/rolling_stock/locomotives/db_br_424-mod/dfl_open.anim"
	mode = "play_forward"
	frames_per_tick = 3.0
animations:
	control_group = "dfl"
	animatrix = "immersiverailroading:models/rolling_stock/locomotives/db_br_424-mod/dfl_close.anim"
	mode = "play_reverse"
	frames_per_tick = 3.0

animations:
	control_group = "drl"
	animatrix = "immersiverailroading:models/rolling_stock/locomotives/db_br_424-mod/drl_open.anim"
	mode = "play_forward"
	frames_per_tick = 3.0
animations:
	control_group = "drl"
	animatrix = "immersiverailroading:models/rolling_stock/locomotives/db_br_424-mod/drl_close.anim"
	mode = "play_reverse"
	frames_per_tick = 3.0

animations:
	control_group = "dfr"
	animatrix = "immersiverailroading:models/rolling_stock/locomotives/db_br_424-mod/dfr_open.anim"
	mode = "play_forward"
	frames_per_tick = 3.0
animations:
	control_group = "dfr"
	animatrix = "immersiverailroading:models/rolling_stock/locomotives/db_br_424-mod/dfr_close.anim"
	mode = "play_reverse"
	frames_per_tick = 3.0
	
animations:
	control_group = "drr"
	animatrix = "immersiverailroading:models/rolling_stock/locomotives/db_br_424-mod/drr_open.anim"
	mode = "play_forward"
	frames_per_tick = 3.0
animations:
	control_group = "drr"
	animatrix = "immersiverailroading:models/rolling_stock/locomotives/db_br_424-mod/drr_close.anim"
	mode = "play_reverse"
	frames_per_tick = 3.0